 {
  "title": "sec",
  "html": "<section class=\"sec\">\n    <div class=\"wrap contact\">\n      <div>\n        \n        <div class=\"c-wa\">\n          <h2>Chat with us</h2>\n          <p>Pick your language and app. Tell us your arrival date, how long you want to stay and your nationality.</p>\n          <div class=\"chat-opts\"><div class=\"lang\"><p><b>English speaking</b><span>We reply in English</span></p><a class=\"ch ch-wa\" href=\"https://wa.me/6287862273133?text=Hello%20Visa4Bali%2C%20I%27d%20like%20to%20ask%20about%20a%20visa\"><svg viewBox=\"0 0 24 24\" fill=\"currentColor\" aria-hidden=\"true\"><path d=\"M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.64.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.6.13-.14.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.03-.52-.07-.15-.67-1.61-.92-2.2-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48s1.07 2.88 1.21 3.08c.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.69.63.71.22 1.36.19 1.87.12.57-.09 1.76-.72 2.01-1.41.25-.69.25-1.29.17-1.41-.07-.12-.27-.2-.57-.35M12.05 21.5a9.4 9.4 0 0 1-4.8-1.32l-.34-.2-3.57.94.95-3.48-.22-.36a9.4 9.4 0 0 1-1.44-5.02c0-5.2 4.23-9.43 9.44-9.43 2.52 0 4.89.98 6.67 2.77a9.36 9.36 0 0 1 2.76 6.67c0 5.2-4.24 9.43-9.44 9.43M20.08 3.9A11.3 11.3 0 0 0 12.05.58C5.79.58.7 5.67.7 11.92c0 2 .52 3.95 1.52 5.67L.6 23.5l6.04-1.58a11.3 11.3 0 0 0 5.4 1.38c6.25 0 11.34-5.09 11.34-11.34 0-3.03-1.18-5.88-3.32-8.02\"/></svg>WhatsApp</a></div></div>\n        </div>\n        <ul class=\"c-list\">\n          <li><i>Office</i>Jl. Pantai Balangan, Jl. B Boulevard No.15<br>Jimbaran, Badung, Bali 80361</li>\n          <li><i>Opening hours</i>Monday – Friday, 08:00 – 17:00</li>\n          <li><i>Phone</i><a class=\"num\" href=\"tel:+6287862273133\">+62 878 6227 3133</a></li>\n          <li><i>Email</i><a href=\"mailto:info1visaforbali@gmail.com\">info1visaforbali@gmail.com</a></li>\n          <li><i>Follow us</i><a href=\"https://www.instagram.com/visa4bali/\">Instagram</a> · <a href=\"https://www.facebook.com/rolly.extensionbali\">Facebook</a> · <a href=\"https://www.tiktok.com/@visa4bali\">TikTok</a></li>\n        </ul>\n      </div>\n\n      <div class=\"form\"><h2>Send us a message</h2><p>Our team will get back to you within 24 hours.</p><div class=\"v4b-formwrap\">[elementor-template id=\"2272\"]</div><p class=\"form-note\">Please don't send passport photos through this form. We'll ask for them on WhatsApp or email.</p></div>\n    </div>\n  </section>",
  "shortcode": true
 },
 {
  "title": "sec stone",
  "html": "<section class=\"sec stone\">\n    <div class=\"wrap areas\">\n      <div>\n        <span class=\"eyebrow\">Passport pick-up</span>\n        <h2 class=\"h2\">We come to your hotel or villa</h2>\n        <p class=\"lead\">Our couriers collect and return passports Monday to Friday, 10:00–16:00. Book one day ahead; the courier arrives within a two-hour window.</p>\n      </div>\n      <div>\n        <ul>\n          <li>Jimbaran</li><li>Uluwatu</li><li>Nusa Dua</li><li>Kuta</li><li>Seminyak</li><li>Kerobokan</li><li>Canggu</li><li>Sanur</li><li>Central Ubud</li>\n          <li class=\"areas-more\">Free pick-up in these areas. Somewhere else? <a href=\"https://wa.me/6287862273133?text=Hello%20Visa4Bali%2C%20I'd%20like%20to%20ask%20about%20a%20visa\">Ask&nbsp;us</a></li>\n        </ul>\n      </div>\n    </div>\n  </section>",
  "shortcode": false
 },
 {
  "title": "sec center",
  "html": "<section class=\"sec center\">\n    <div class=\"wrap\">\n      <h2 class=\"h2\">Visit our office</h2>\n      <div class=\"offices\">\n        <div class=\"office\" style=\"background:var(--stone)\">\n          <iframe title=\"Map of the Visa4Bali head office in Balangan\" loading=\"lazy\" src=\"https://maps.google.com/maps?q=Jl.%20Pantai%20Balangan%20Jl.%20B%20Boulevard%20No.15%2C%20Jimbaran%2C%20Kec.%20Kuta%20Sel.%2C%20Kabupaten%20Badung%2C%20Bali%2080361&amp;t=m&amp;z=16&amp;output=embed&amp;iwloc=near\"></iframe>\n          <div class=\"office-body\"><h3>Balangan, Bali</h3><p>Jl. Pantai Balangan, Jl. B Boulevard No.15, Jimbaran, Badung, Bali 80361</p><p>Monday – Friday, 08:00 – 17:00</p><a href=\"https://maps.google.com/?q=Jl.%20Pantai%20Balangan%20Jl.%20B%20Boulevard%20No.15%2C%20Jimbaran\">Get directions</a></div>\n        </div>\n      </div>\n      <div class=\"notice on-white\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M12 3 4 6v6c0 4.5 3.4 8.3 8 9 4.6-.7 8-4.5 8-9V6Z\"/><path d=\"m9 12 2 2 4-4\"/></svg><p><b>Beware of scammers.</b> Our bank account is only under the VISA4BALI name. We do not have bank accounts under foreigners' names.</p></div>\n    </div>\n  </section>",
  "shortcode": false
 }
