[
 {
  "title": "p-hero short",
  "html": "<section class=\"p-hero short\">\n    <img src=\"https://visa4bali.com/wp-content/uploads/2026/11/v4b-b-ulun-danu.jpg\" alt=\"\" width=\"1600\" height=\"1067\">\n    <div class=\"wrap\">\n      <h1>About us</h1>\n      <p class=\"lead\">A visa agency in Balangan, Bali, since 2014.</p>\n    </div>\n  </section>",
  "shortcode": false
 },
 {
  "title": "sec",
  "html": "<section class=\"sec\">\n    <div class=\"wrap story\">\n      <figure>\n        <img class=\"full\" src=\"https://visa4bali.com/wp-content/uploads/2026/11/v4b-b-owner.jpg\" alt=\"Mr. Rolly, founder of Visa4Bali, in a blue blazer, smiling and giving a thumbs up\" width=\"1066\" height=\"1600\">\n        <figcaption>Mr. Rolly, founder</figcaption>\n      </figure>\n      <div>\n        <span class=\"eyebrow\">Our story</span>\n        <h2 class=\"h2\">Visa services from people who have done this for twelve years</h2>\n        <p>Visa4Bali is the trading name of PT Visa Empat Bali. Mr. Rolly started the agency in Balangan in 2014 to help foreign visitors with Indonesian visas and extensions, and he still handles difficult stay-permit cases himself.</p>\n        <p>We take care of each application from start to finish: we collect the documents, prepare the forms, deal with immigration, and bring your passport back. We work in English and Russian.</p>\n        <p class=\"quote\">We prepare the application for you. When something goes wrong with your stay permit, we solve it.</p>\n      </div>\n    </div>\n  </section>",
  "shortcode": false
 },
 {
  "title": "sec sea",
  "html": "<section class=\"sec sea\">\n    <div class=\"wrap\">\n      <span class=\"eyebrow\">How we work</span>\n      <h2 class=\"h2\">Direct, transparent, close by</h2>\n      <div class=\"ways\">\n        <div><h3>Direct with immigration</h3><p>We work with immigration officials ourselves, not through brokers. That is why our prices stay clear and predictable.</p></div>\n        <div><h3>One person on your case</h3><p>The person handling your visa keeps you updated on WhatsApp until your passport or e-visa is back with you.</p></div>\n        <div><h3>We come to you</h3><p>Our staff can collect your documents from your preferred location and bring them back when the visa is done.</p></div>\n      </div>\n    </div>\n  </section>",
  "shortcode": false
 },
 {
  "title": "sec",
  "html": "<section class=\"sec\">\n    <div class=\"wrap\">\n      <span class=\"eyebrow\">Our team</span>\n      <h2 class=\"h2\">The people who handle your visa</h2>\n      <p class=\"lead\">The team you will meet at our office and on WhatsApp.</p>\n      <ul class=\"staff\"><li><img src=\"https://visa4bali.com/wp-content/uploads/2026/11/v4b-b-staff-ari.jpg\" alt=\"Ari, Operations Manager at Visa4Bali\" width=\"480\" height=\"600\" loading=\"lazy\"><b>Ari</b><span>Operations Manager</span></li><li><img src=\"https://visa4bali.com/wp-content/uploads/2026/11/v4b-b-staff-janu.jpg\" alt=\"Janu, Operations Assistant at Visa4Bali\" width=\"480\" height=\"600\" loading=\"lazy\"><b>Janu</b><span>Operations Assistant</span></li><li><img src=\"https://visa4bali.com/wp-content/uploads/2026/11/v4b-b-staff-nanda.jpg\" alt=\"Nanda, Customer Service at Visa4Bali\" width=\"480\" height=\"600\" loading=\"lazy\"><b>Nanda</b><span>Customer Service</span></li><li><img src=\"https://visa4bali.com/wp-content/uploads/2026/11/v4b-b-staff-feny.jpg\" alt=\"Feny, Customer Service at Visa4Bali\" width=\"480\" height=\"600\" loading=\"lazy\"><b>Feny</b><span>Customer Service</span></li><li><img src=\"https://visa4bali.com/wp-content/uploads/2026/11/v4b-b-staff-yosi.jpg\" alt=\"Yosi, KITAS Specialist at Visa4Bali\" width=\"480\" height=\"600\" loading=\"lazy\"><b>Yosi</b><span>KITAS Specialist</span></li><li><img src=\"https://visa4bali.com/wp-content/uploads/2026/11/v4b-b-staff-orest.jpg\" alt=\"Orest, KITAS Specialist at Visa4Bali\" width=\"480\" height=\"600\" loading=\"lazy\"><b>Orest</b><span>KITAS Specialist</span></li><li><img src=\"https://visa4bali.com/wp-content/uploads/2026/11/v4b-b-staff-wira.jpg\" alt=\"Wira, Field Coordinator at Visa4Bali\" width=\"480\" height=\"600\" loading=\"lazy\"><b>Wira</b><span>Field Coordinator</span></li><li><img src=\"https://visa4bali.com/wp-content/uploads/2026/11/v4b-b-staff-chandra.jpg\" alt=\"Chandra, Client Relations Coordinator at Visa4Bali\" width=\"480\" height=\"600\" loading=\"lazy\"><b>Chandra</b><span>Client Relations Coordinator</span></li><li><img src=\"https://visa4bali.com/wp-content/uploads/2026/11/v4b-b-staff-febri.jpg\" alt=\"Febri, Pickup & Delivery Courier at Visa4Bali\" width=\"480\" height=\"600\" loading=\"lazy\"><b>Febri</b><span>Pickup &amp; Delivery Courier</span></li><li><img src=\"https://visa4bali.com/wp-content/uploads/2026/11/v4b-b-staff-lily.jpg\" alt=\"Lily, Database Administrator at Visa4Bali\" width=\"480\" height=\"600\" loading=\"lazy\"><b>Lily</b><span>Database Administrator</span></li><li><img src=\"https://visa4bali.com/wp-content/uploads/2026/11/v4b-b-staff-fendy.jpg\" alt=\"Fendy, Online Application Specialist at Visa4Bali\" width=\"480\" height=\"600\" loading=\"lazy\"><b>Fendy</b><span>Online Application Specialist</span></li><li><img src=\"https://visa4bali.com/wp-content/uploads/2026/11/v4b-b-staff-kadek.jpg\" alt=\"Kadek, Online Application Specialist at Visa4Bali\" width=\"480\" height=\"600\" loading=\"lazy\"><b>Kadek</b><span>Online Application Specialist</span></li><li><img src=\"https://visa4bali.com/wp-content/uploads/2026/11/v4b-b-staff-hulwa.jpg\" alt=\"Hulwa, Online Application Specialist at Visa4Bali\" width=\"480\" height=\"600\" loading=\"lazy\"><b>Hulwa</b><span>Online Application Specialist</span></li><li><img src=\"https://visa4bali.com/wp-content/uploads/2026/11/v4b-b-staff-primawan.jpg\" alt=\"Primawan, Driver & Vehicle Care Staff at Visa4Bali\" width=\"480\" height=\"600\" loading=\"lazy\"><b>Primawan</b><span>Driver &amp; Vehicle Care Staff</span></li><li><img src=\"https://visa4bali.com/wp-content/uploads/2026/11/v4b-b-staff-juniarta.jpg\" alt=\"Juniarta, Security Staff at Visa4Bali\" width=\"480\" height=\"600\" loading=\"lazy\"><b>Juniarta</b><span>Security Staff</span></li><li><img src=\"https://visa4bali.com/wp-content/uploads/2026/11/v4b-b-staff-wirata.jpg\" alt=\"Wirata, Security Staff at Visa4Bali\" width=\"480\" height=\"600\" loading=\"lazy\"><b>Wirata</b><span>Security Staff</span></li><li><img src=\"https://visa4bali.com/wp-content/uploads/2026/11/v4b-b-staff-gede.jpg\" alt=\"Gede, Security Staff at Visa4Bali\" width=\"480\" height=\"600\" loading=\"lazy\"><b>Gede</b><span>Security Staff</span></li><li><img src=\"https://visa4bali.com/wp-content/uploads/2026/11/v4b-b-staff-hasim.jpg\" alt=\"Hasim, Security Staff at Visa4Bali\" width=\"480\" height=\"600\" loading=\"lazy\"><b>Hasim</b><span>Security Staff</span></li><li><img src=\"https://visa4bali.com/wp-content/uploads/2026/11/v4b-b-staff-marlon.jpg\" alt=\"Marlon, Housekeeping Staff at Visa4Bali\" width=\"480\" height=\"600\" loading=\"lazy\"><b>Marlon</b><span>Housekeeping Staff</span></li></ul>\n    </div>\n  </section>",
  "shortcode": false
 },
 {
  "title": "sec stone center",
  "html": "<section class=\"sec stone center\">\n    <div class=\"wrap\">\n      <h2 class=\"h2\">Visit our office</h2>\n      <div class=\"offices\">\n        <div class=\"office\">\n          <iframe title=\"Map of the Visa4Bali head office in Balangan\" loading=\"lazy\" src=\"https://maps.google.com/maps?q=Jl.%20Pantai%20Balangan%20Jl.%20B%20Boulevard%20No.15%2C%20Jimbaran%2C%20Kec.%20Kuta%20Sel.%2C%20Kabupaten%20Badung%2C%20Bali%2080361&amp;t=m&amp;z=16&amp;output=embed&amp;iwloc=near\"></iframe>\n          <div class=\"office-body\"><h3>Balangan, Bali</h3><p>Jl. Pantai Balangan, Jl. B Boulevard No.15, Jimbaran, Badung, Bali 80361</p><p>Monday – Friday, 08:00 – 17:00</p><a href=\"https://maps.google.com/?q=Jl.%20Pantai%20Balangan%20Jl.%20B%20Boulevard%20No.15%2C%20Jimbaran\">Get directions</a></div>\n        </div>\n      </div>\n    </div>\n  </section>",
  "shortcode": false
 },
 {
  "title": "sec ask center",
  "html": "<section class=\"sec ask center\">\n    <div class=\"wrap\">\n      <h2 class=\"h2\">Tell us about your trip</h2>\n      <p class=\"lead\">Send us your arrival date, how long you want to stay and your nationality. We will tell you which visa fits and what it costs before you pay anything.</p>\n      \n      <a class=\"btn btn-k\" href=\"https://wa.me/6287862273133?text=Hello%20Visa4Bali%2C%20I'd%20like%20to%20ask%20about%20a%20visa\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M7.9 20A9 9 0 1 0 4 16.1L2 22Z\"/></svg>Chat with us</a>\n      <small>WhatsApp or Telegram, in English or Russian · Monday to Friday, 08:00–17:00</small>\n    </div>\n  </section>",
  "shortcode": false
 }
]